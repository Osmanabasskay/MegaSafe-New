# Mi Osusu — environment variable reference
# Copy to .env and fill in real values.
# NEVER commit .env to git (.gitignore covers it).
#
# ─────────────────────────────────────────────────────────────────────────────
# MOBILE APP  (Expo / React Native)
# These are PUBLIC — bundled into the app binary.
# The anon key is safe to expose: Row Level Security is the defence layer.
# ─────────────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Must match Supabase Dashboard -> Auth -> Providers -> Email -> OTP length.
EXPO_PUBLIC_SUPABASE_OTP_LENGTH=8

# Required when testing Google OAuth on a physical device via ADB port forwarding.
# Set to your dev machine's LAN IP + port (e.g. http://192.168.1.100:3000).
# In production, set to your deployed domain (e.g. https://miosusu.app).
# Leave blank when testing on the same machine as the dev server.
EXPO_PUBLIC_APP_URL=

# ─────────────────────────────────────────────────────────────────────────────
# ADMIN PANEL  (Next.js — server-side env vars only)
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS — keep it server-side only.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─────────────────────────────────────────────────────────────────────────────
# ADMIN SECURITY
# Comma-separated IPs allowed to reach admin panel. Leave blank for all IPs.
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_IP_ALLOWLIST=

# ─────────────────────────────────────────────────────────────────────────────
# EDGE FUNCTION SECRETS — Monime Payment Integration
#
# Set via Supabase Dashboard → Project Settings → Edge Functions → Secrets
# OR via Supabase CLI:
#   supabase secrets set MONIME_ACCESS_TOKEN=mon_test_...
#   supabase secrets set MONIME_SPACE_ID=spc_...
#   supabase secrets set MONIME_WEBHOOK_SECRET=<32-256-char-hs256-secret>
#   supabase secrets set MONIME_VAULT_WEBHOOK_SECRET=<second-32-256-char-hs256-secret>
#
# These are NOT read from .env at runtime — they are injected by Supabase.
# Listing them here documents what must be configured before deployment.
# ─────────────────────────────────────────────────────────────────────────────

# ── Monime API (primary payment gateway) ─────────────────────────────────────
# Source: Monime Dashboard → Developers/API Access → Personal Access Tokens
# Test tokens start with mon_test_; live tokens start with mon_.
MONIME_ACCESS_TOKEN=mon_test_replace_with_your_monime_access_token

# Source: Monime Dashboard → Space settings/details
MONIME_SPACE_ID=spc_replace_with_your_monime_space_id

# Source: Monime Dashboard → Settings → Webhooks → Signing Secret
# Use this for the main contribution/payment webhook:
#   https://YOUR-PROJECT-REF.supabase.co/functions/v1/mobile-money-webhook
MONIME_WEBHOOK_SECRET=replace_with_32_to_256_char_hs256_webhook_secret

# Optional separate signing secret for the vault top-up webhook:
#   https://YOUR-PROJECT-REF.supabase.co/functions/v1/vault-webhook
# If omitted, vault-webhook falls back to MONIME_WEBHOOK_SECRET.
MONIME_VAULT_WEBHOOK_SECRET=replace_with_second_32_to_256_char_hs256_webhook_secret

# Optional separate signing secret for the payout (withdrawal) webhook:
#   https://YOUR-PROJECT-REF.supabase.co/functions/v1/payout-webhook
# If omitted, payout-webhook falls back to MONIME_WEBHOOK_SECRET.
# Subscribe this endpoint to payout.* events in the Monime dashboard.
MONIME_PAYOUT_WEBHOOK_SECRET=replace_with_third_32_to_256_char_hs256_webhook_secret

# Monime API base URL. Defaults to the live URL when unset.
# For sandbox testing either set the sandbox URL here or set MONIME_ENV=sandbox.
# Never expose this or any Monime credential to the frontend.
MONIME_BASE_URL=https://api.monime.io
# MONIME_ENV=sandbox

# Advanced KYC AI validation Edge Function secrets.
# Set these in Supabase Edge Function Secrets, not in the mobile app.
# If any required provider secret is missing, validate-kyc-identity fails closed
# by sending the KYC application to manual admin review.
KYC_AI_PROVIDER=external_kyc_ai
KYC_OCR_ENDPOINT=https://your-kyc-provider.example.com/ocr
KYC_OCR_API_KEY=replace_with_server_side_ocr_key
KYC_FACE_ENDPOINT=https://your-kyc-provider.example.com
KYC_FACE_API_KEY=replace_with_server_side_face_key
KYC_MIN_BRIGHTNESS=0.55
KYC_MIN_SHARPNESS=0.60
KYC_FACE_MATCH_THRESHOLD=0.92

# ── App routing ──────────────────────────────────────────────────────────────
# No APP_RETURN_URL is needed for the current Monime Payment Codes flow.
# Users dial the generated USSD code; settlement is completed by Monime webhooks.

# ─────────────────────────────────────────────────────────────────────────────
# Automatically injected by Supabase into every Edge Function
# (listed here for documentation — do NOT set manually):
#
# SUPABASE_URL                  — Your project's API URL
# SUPABASE_ANON_KEY             — Public anon key
# SUPABASE_SERVICE_ROLE_KEY     — Service role key (bypasses RLS)
# SUPABASE_DB_URL               — Direct Postgres connection string
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# EAS / EXPO BUILD
# ─────────────────────────────────────────────────────────────────────────────
# EXPO_ACCESS_TOKEN=your-expo-access-token

# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEV TOOLING — Claude Code MCP servers
# Referenced by .mcp.json as ${TESTSPRITE_API_KEY}. Claude Code reads it from the
# OS environment, so also set it as a user env var:
#   setx TESTSPRITE_API_KEY "<value>"
# Source: TestSprite Dashboard → API Keys
# ─────────────────────────────────────────────────────────────────────────────
# TESTSPRITE_API_KEY=sk-user-replace_with_your_testsprite_api_key
