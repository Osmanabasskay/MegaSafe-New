# MegaSafe — environment variable reference
# Copy this file to .env and fill in real values.
# NEVER commit .env to git. It is permanently listed in .gitignore.
#
# ─────────────────────────────────────────────────────────────────────────────
# MOBILE APP  (Expo / React Native)
# These are public — they are bundled into the app binary.
# Anon key is safe to expose: Row Level Security on Supabase is the defence.
# ─────────────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─────────────────────────────────────────────────────────────────────────────
# ADMIN PANEL  (Next.js — server-side only)
# SUPABASE_SERVICE_ROLE_KEY must NEVER be used in Expo/React Native code.
# It bypasses RLS. Keep it in server environment variables only.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─────────────────────────────────────────────────────────────────────────────
# ADMIN SECURITY
# Comma-separated IPs allowed to reach admin panel.
# Leave blank to allow all IPs (not recommended for production).
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_IP_ALLOWLIST=

# ─────────────────────────────────────────────────────────────────────────────
# EDGE FUNCTION SECRETS
# Set these in Supabase Dashboard → Project Settings → Edge Functions → Secrets.
# Do NOT put them in .env — they are server-side only and not read locally.
# ─────────────────────────────────────────────────────────────────────────────
# ORANGE_MONEY_API_KEY=your-orange-money-api-key
# ORANGE_MONEY_MERCHANT_KEY=your-orange-money-merchant-key
# ORANGE_MONEY_WEBHOOK_SECRET=your-orange-money-webhook-secret
# ORANGE_MONEY_BASE_URL=https://api.orange.com/orange-money-webpay/sl/v1
# AFRIMONEY_API_KEY=your-afrimoney-api-key
# AFRIMONEY_WEBHOOK_SECRET=your-afrimoney-webhook-secret
# QMONEY_API_KEY=your-qmoney-api-key
# QMONEY_WEBHOOK_SECRET=your-qmoney-webhook-secret
# FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key
# FLUTTERWAVE_WEBHOOK_SECRET=your-flutterwave-webhook-secret
# WEBHOOK_BASE_URL=https://your-app.supabase.co/functions/v1

# ─────────────────────────────────────────────────────────────────────────────
# EAS / EXPO BUILD (set via: eas secret:create)
# EXPO_ACCESS_TOKEN=your-expo-access-token
# ─────────────────────────────────────────────────────────────────────────────
