# Normalise all text files to LF on commit so the tree doesn't accumulate
# CRLF/LF mixed noise. Developers on Windows get CRLF in their working tree
# (the default when core.autocrlf=true), but the repo object store stays LF.
* text=auto eol=lf

# Explicitly binary — never mangle these
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.eot  binary
*.zip  binary
*.tar  binary
*.gz   binary

# Next.js / webpack pack files are binary blobs
*.pack binary
