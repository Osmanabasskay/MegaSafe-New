# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Build / coverage output (regenerable — never commit)
coverage/
.next/
apps/*/.next/
out/

# AI / agent tooling caches (machine-local, not project source)
.agents/
.codex/
.claude/skills/

# Test runner scratch
testsprite_tests/tmp/
*.log

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Executables / binaries — never commit these to the repo
*.exe
*.dll
*.so
*.dylib

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files — IMPORTANT: .env must be listed explicitly
# .env*.local matches .env.local etc but NOT bare `.env`
.env
.env.*
apps/admin/.env
apps/admin/.env.*

# Keep safe template files only
!.env.example
!apps/admin/.env.example



# Production database dumps — NEVER commit real data to the repo
prod_*.sql
*_clone.sql
*_backup.sql
*.dump

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

testsprite_tests\tmp\config.json
