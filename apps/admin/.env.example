# Mi Osusu Admin Panel — environment variables
# Copy to apps/admin/.env and fill in real values.
# NEVER commit .env to git.

# ── Supabase (public — used by Next.js for client-side Supabase calls) ────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Supabase service role — SERVER-SIDE ONLY ──────────────────────────────────
# Used exclusively in API route handlers (never in browser-side code).
# Bypasses Row Level Security — treat like a root database password.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Admin security ────────────────────────────────────────────────────────────
# Comma-separated IPv4/IPv6 addresses allowed to reach this admin panel.
# Example: ADMIN_IP_ALLOWLIST=203.0.113.10,2001:db8::1
# Leave blank to allow all IPs (development only — lock this down in production).
ADMIN_IP_ALLOWLIST=

# HMAC-SHA-256 signing secret for the short-lived role-cache cookie set by middleware.
# Keeps the DB round trip to one per 30 s per admin session instead of every navigation.
# Generate with: openssl rand -hex 32
# SERVER-SIDE ONLY — never set this as NEXT_PUBLIC_*.
ADMIN_ROLE_CACHE_SECRET=

# Public URL of this admin app (used for same-origin redirect safety in /api/logout).
# Example: https://admin.miosusu.sl
NEXT_PUBLIC_ADMIN_URL=
