{
  "name": "mi-osusu",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "postinstall": "node scripts/patch-expo-keep-awake.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:rls": "npx tsx scripts/test-rls.ts",
    "test:phase10": "node scripts/phase10/static-security-audit.mjs",
    "test:privilege-static": "node scripts/privilege-escalation-audit.mjs",
    "test:privilege-live": "npx tsx scripts/test-privilege-escalation.ts",
    "test:privilege": "npm run test:privilege-static && npm run test:privilege-live",
    "test:security": "npm run test:privilege-static && npm run test:rls && npm run test:privilege-live",
    "phase10:check": "npm run typecheck && npm run test:phase10 && npm run test:privilege-static"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@supabase/supabase-js": "^2.101.1",
    "@tanstack/react-query": "^5.96.2",
    "expo": "~54.0.34",
    "expo-audio": "~1.1.1",
    "expo-auth-session": "~7.0.11",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-contacts": "~15.0.11",
    "expo-file-system": "^19.0.22",
    "expo-font": "~14.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "~17.0.8",
    "expo-notifications": "^0.32.17",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "lucide-react-native": "^1.7.0",
    "nativewind": "^4.2.3",
    "react": "19.1.0",
    "react-hook-form": "^7.72.1",
    "react-native": "0.81.5",
    "react-native-mmkv": "^4.3.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-vector-icons": "^10.3.0",
    "react-native-worklets": "^0.5.1",
    "tailwindcss": "^3.4.19",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "@vitest/coverage-v8": "^4.1.7",
    "babel-preset-expo": "~54.0.10",
    "typescript": "~5.9.2",
    "vitest": "^4.1.7"
  },
  "private": true
}
